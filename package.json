{
  "name": "tcc",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:mockup": "turbo run dev --filter=mockup",
    "dev:api": "turbo run dev --filter=api",
    "lint": "turbo run lint && node scripts/design-check.mjs",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate --filter=api",
    "db:migrate": "turbo run db:migrate --filter=api",
    "db:studio": "turbo run db:studio --filter=api"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.4.4",
    "typescript": "^5.6.3"
  }
}
